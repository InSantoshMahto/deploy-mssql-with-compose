# SQL Server Environment Variables
# Copy this file to .env and update with your values
# WARNING: Never commit .env to version control!

# ==============================================================================
# REQUIRED VARIABLES
# ==============================================================================

# SA (System Administrator) Password
# Requirements:
# - At least 8 characters
# - Contains uppercase, lowercase, digits, and special characters
# - Example: YourStrong!Passw0rd
SA_PASSWORD=YourStrong!Passw0rd

# ==============================================================================
# OPTIONAL VARIABLES (defaults are provided)
# ==============================================================================

# Accept End-User License Agreement
# Options: Y (yes) or N (no)
# Default: Y
ACCEPT_EULA=Y

# SQL Server Edition
# Options: Developer, Express, Standard, Enterprise, Evaluation
# Default: Developer
MSSQL_PID=Developer

# Enable SQL Server Agent
# Options: true or false
# Default: true
MSSQL_AGENT_ENABLED=true

# SQL Server Collation
# Determines sorting and comparison rules for string data
# Default: SQL_Latin1_General_CP1_CI_AS
# Common options:
#   - SQL_Latin1_General_CP1_CI_AS (Case-Insensitive, Accent-Sensitive)
#   - SQL_Latin1_General_CP1_CS_AS (Case-Sensitive, Accent-Sensitive)
MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS

# Memory Limit (in MB)
# Amount of memory SQL Server can use
# Default: 2048 (2GB)
# Recommended: Set to 50-80% of available system memory
MSSQL_MEMORY_LIMIT_MB=2048

# SQL Server Port
# External port to expose SQL Server
# Default: 1433
SQL_PORT=1433
